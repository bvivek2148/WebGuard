# =============================================================================
# WebGuard - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your details
# =============================================================================

# Frontend Connection (Vite -> FastAPI WAF)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/events

# WAF Reverse Proxy Backend Configuration
WAF_HOST=127.0.0.1
WAF_PORT=8000
TARGET_BACKEND_URL=http://localhost:8080
WAF_MODE=blocking
BLOCKING_THRESHOLD=0.80
RATE_LIMIT_RPM=100

# SQLite Database Persistence
DATABASE_URL=sqlite:///backend/webguard.db

# Authentication Secret (Change in production)
SECRET_KEY=webguard-super-secret-key-change-in-production

# Google Gemini Generative AI (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
